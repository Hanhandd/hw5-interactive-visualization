  "params": [
    {
      "name": "countryFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Brazil",
          "China",
          "France",
          "Germany",
          "India",
          "Japan",
          "Nigeria",
          "South Africa",
          "United Kingdom",
          "United States"
        ],
        "name": "Country: "
      }
    },
    {
      "name": "metricFilter",
      "value": "gdp_per_capita",
      "bind": {
        "input": "radio",
        "options": [
          "gdp_per_capita",
          "gdp_growth"
        ],
        "labels": [
          "GDP per capita",
          "GDP growth rate"
        ],
        "name": "Metric: "
      }
    },
    {
      "name": "yearFilter",
      "value": 2020,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2020,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "vconcat": [
    {
      "title": "Long-term trend with event annotations",
      "height": 340,
      "transform": [
        {
          "filter": "countryFilter == 'All' || datum.country == countryFilter"
        },
        {
          "calculate": "metricFilter == 'gdp_per_capita' ? datum.gdp_per_capita : datum.gdp_growth",
          "as": "metricValue"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "point": true
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": "Year"
            },
            "y": {
